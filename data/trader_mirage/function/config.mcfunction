# /function trader_mirage:config   (also opened by /trigger tm_config)
function trader_mirage:calc_chance
scoreboard players operation #whole tm_state = #chance tm_state
scoreboard players operation #whole tm_state /= #ten tm_state
scoreboard players operation #tenth tm_state = #chance tm_state
scoreboard players operation #tenth tm_state %= #ten tm_state
scoreboard players operation #ew tm_state = #easy tm_cfg
scoreboard players operation #ew tm_state /= #ten tm_state
scoreboard players operation #et tm_state = #easy tm_cfg
scoreboard players operation #et tm_state %= #ten tm_state
scoreboard players operation #nw tm_state = #normal tm_cfg
scoreboard players operation #nw tm_state /= #ten tm_state
scoreboard players operation #nt tm_state = #normal tm_cfg
scoreboard players operation #nt tm_state %= #ten tm_state
scoreboard players operation #hw tm_state = #hard tm_cfg
scoreboard players operation #hw tm_state /= #ten tm_state
scoreboard players operation #ht tm_state = #hard tm_cfg
scoreboard players operation #ht tm_state %= #ten tm_state
tellraw @s [{"text":"------------------------------","color":"light_purple","bold":true},{"text":"\n Trader Mirage ","color":"light_purple","bold":true},{"text":"Settings\n","bold":true},{"text":"------------------------------","color":"light_purple","bold":true}]
tellraw @s [{"text":"Streak of ordinary traders: ","color":"gray"},{"score":{"name":"#pity","objective":"tm_state"},"color":"white"}]
execute if score #diff tm_state matches 0 run tellraw @s [{"text":"Difficulty: ","color":"gray"},{"text":"Peaceful (disguises paused)"}]
execute if score #diff tm_state matches 1 run tellraw @s [{"text":"Difficulty: ","color":"gray"},{"text":"Easy"},{"text":"  |  next trader is an illusioner: ","color":"gray"},{"score":{"name":"#whole","objective":"tm_state"},"color":"white"},{"text":"."},{"score":{"name":"#tenth","objective":"tm_state"},"color":"white"},{"text":"%"}]
execute if score #diff tm_state matches 2 run tellraw @s [{"text":"Difficulty: ","color":"gray"},{"text":"Normal"},{"text":"  |  next trader is an illusioner: ","color":"gray"},{"score":{"name":"#whole","objective":"tm_state"},"color":"white"},{"text":"."},{"score":{"name":"#tenth","objective":"tm_state"},"color":"white"},{"text":"%"}]
execute if score #diff tm_state matches 3 run tellraw @s [{"text":"Difficulty: ","color":"gray"},{"text":"Hard"},{"text":"  |  next trader is an illusioner: ","color":"gray"},{"score":{"name":"#whole","objective":"tm_state"},"color":"white"},{"text":"."},{"score":{"name":"#tenth","objective":"tm_state"},"color":"white"},{"text":"%"}]
